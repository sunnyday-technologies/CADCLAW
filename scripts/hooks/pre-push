#!/bin/sh
# Local prevention gate. CI is only a post-publication backstop.

fail_runtime() {
  echo "prepublication-gate: status=error surface=runtime pattern=$1 ordinal=1" >&2
  exit 2
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || fail_runtime SYSTEM-REPOSITORY-ROOT
cd "$repo_root" 2>/dev/null || fail_runtime SYSTEM-REPOSITORY-ROOT

updates=
while IFS= read -r update_line; do
  updates="${updates}${update_line}
"
done
[ -n "$updates" ] || fail_runtime SYSTEM-UPDATES-EMPTY

python_path=$(git config --local --get prepublication.python 2>/dev/null || true)
if [ -z "$python_path" ] || [ ! -f "$python_path" ]; then
  fail_runtime SYSTEM-PYTHON-CONFIG
fi

# This object-level scanner must run before the project-specific MARB guard.
printf '%s' "$updates" | \
  "$python_path" scripts/prepublication_gate.py pre-push --updates-stdin || exit $?

"$python_path" scripts/check_no_answer_keys.py --tree HEAD || exit $?

printf '%s' "$updates" | while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    "$python_path" scripts/check_no_answer_keys.py --range "$local_sha" || exit $?
  else
    "$python_path" scripts/check_no_answer_keys.py \
      --range "$remote_sha..$local_sha" || exit $?
  fi
done || exit $?

exit 0
