__pycache__/
*.pyc
*.egg-info/
dist/
build/
.cloudflare/
.wrangler/
.venv/
.uv-cache/
*.step
# ...but the worked example's authored stand-in parts must ship, or the
# example is broken on clone. Three ~15 KB boxes, no private geometry.
!examples/relative_placement/parts/*.step

# Private working tree: design plans, frame canon, unpublished notes. This was
# previously ignored only via .git/info/exclude, which is local to one clone
# and never travels — a fresh clone or CI runner had no protection at all.
# Enforced as well by scripts/check_no_answer_keys.sh + the key-guard workflow.
_private/

# MARB answer-key material must never land in this public repo. It is
# distributed through the gated Hugging Face dataset.
**/m3_reference_round1.step
**/*reference*.step
**/ph[0-9]*_reference*
*.stl
.DS_Store
Thumbs.db
.claude/
docs/media/*.png
!docs/media/cadclaw_*.png

# Secrets / environment files
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# Benchmark content lives in the separate MARB repo (firewalled out, ebd8ff0)
benchmarks/

# Licensed display fonts (Typodermic Nulshock/Sifonn) — not redistributable
docs/fonts/

# Internal editorial / publication process notes (contain local paths)
docs/publication/

# ── Local-only: CADCLAW explainer / video production ────────────────────────
# Renders, frame-audit stills, narration, and the ~50 one-shot composition
# scripts behind the explainer video. Unpublished production work: not in the
# pip package, not on the build-site.ps1 allowlist, not for the public repo.
# These previously sat merely untracked, so a single `git add -A` would have
# published all of it. Structural exclusion, not luck.
docs/CADCLAW_EXPLAINER_*
docs/STUDIO_NARRATION_*
scripts/audit_cadclaw_explainer_*
scripts/diagnose_cadclaw_*
scripts/diagnose_measure_dial_component.py
scripts/polish_cadclaw_explainer_*
scripts/recompose_cadclaw_explainer_*
scripts/fix_cadclaw_explainer_*
scripts/fix_cadclaw_v*
scripts/run_cadclaw_v*
scripts/set_cadclaw_v*
scripts/widen_cadclaw_v*
scripts/test_cadclaw_claw_cleanup_variants.py
claw_cleanup_variants/
claw_component_diagnostic_*/
tmp_v*_transfer/
/v[0-9]*.jpg
/v[0-9]*.png
/v[0-9]*.log

# Media withdrawn from the site 2026-08-21 (kept locally, never served)
_unpublished_media_*/
