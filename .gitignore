__pycache__/
*.pyc
*.egg-info/
dist/
build/
.cloudflare/
.wrangler/
.venv/
.uv-cache/
*.step
# ...but the worked example's authored stand-in parts must ship, or the
# example is broken on clone. Three ~15 KB boxes, no private geometry.
!examples/relative_placement/parts/*.step

# Private working tree: design plans, frame canon, unpublished notes. This was
# previously ignored only via .git/info/exclude, which is local to one clone
# and never travels — a fresh clone or CI runner had no protection at all.
# Enforced as well by scripts/check_no_answer_keys.sh + the key-guard workflow.
_private/

# MARB answer-key material must never land in this public repo. It is
# distributed through the gated Hugging Face dataset.
**/m3_reference_round1.step
**/*reference*.step
**/ph[0-9]*_reference*
*.stl
.DS_Store
Thumbs.db
.claude/
docs/media/*.png
!docs/media/cadclaw_*.png

# Secrets / environment files
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# Benchmark content lives in the separate MARB repo (firewalled out, ebd8ff0)
benchmarks/

# Licensed display fonts (Typodermic Nulshock/Sifonn) — not redistributable
docs/fonts/

# Internal editorial / publication process notes (contain local paths)
docs/publication/
